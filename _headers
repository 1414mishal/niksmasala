# Cloudflare Pages headers.
# Force browsers to re-check the code files on every load (via ETag), so a new
# deploy shows up immediately instead of serving a stale cached copy. This is
# why earlier changes "didn't appear" without a hard refresh.
# (Images keep Cloudflare's default caching for speed.)

/assets/app.js
  Cache-Control: no-cache
/assets/theme-app.js
  Cache-Control: no-cache
/assets/theme-anim.js
  Cache-Control: no-cache
/assets/theme.css
  Cache-Control: no-cache
/assets/style.css
  Cache-Control: no-cache
/assets/recipes-page.js
  Cache-Control: no-cache
/assets/supabase.min.js
  Cache-Control: no-cache
